@model List<UniversityEnrolment.Models.Student>
@{
    ViewData["Title"] = "Students";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Students</h1>
    <a asp-action="Create" class="btn btn-primary">Add student</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No students yet. Click <strong>Add student</strong> to create one.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Student No.</th><th>Name</th><th>Email</th><th>Courses</th><th></th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StudentNumber</td>
                <td>@s.FullName</td>
                <td>@s.Email</td>
                <td>@s.GetCourses().Count</td>
                <td class="text-end text-nowrap">
                    <a asp-action="MyCourses" asp-route-id="@s.StudentNumber" class="btn btn-sm btn-outline-success">My courses</a>
                    <a asp-action="Edit" asp-route-id="@s.StudentNumber" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@s.StudentNumber" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
