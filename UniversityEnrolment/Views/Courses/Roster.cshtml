@model UniversityEnrolment.Models.ViewModels.CourseRosterViewModel
@{
    ViewData["Title"] = "Roster";
    var others = ViewBag.AllStudents as List<UniversityEnrolment.Models.Student> ?? new();
}
<h1>Roster: @Model.Course.CourseCode - @Model.Course.Name</h1>
<p class="text-muted">Instructor: @Model.Course.Instructor &middot; @Model.Students.Count / @Model.Course.Capacity enrolled</p>

<table class="table table-striped align-middle">
    <thead><tr><th>Student No.</th><th>Name</th><th>Email</th><th></th></tr></thead>
    <tbody>
    @if (!Model.Students.Any())
    {
        <tr><td colspan="4" class="text-muted">No students enrolled yet.</td></tr>
    }
    @foreach (var s in Model.Students)
    {
        <tr>
            <td>@s.StudentNumber</td>
            <td>@s.FullName</td>
            <td>@s.Email</td>
            <td class="text-end">
                <form asp-action="RemoveFromRoster" asp-route-id="@Model.Course.CourseCode" method="post" class="d-inline">
                    <input type="hidden" name="studentNumber" value="@s.StudentNumber" />
                    <button class="btn btn-sm btn-outline-danger">Remove</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (others.Any())
{
    <form asp-action="AddToRoster" asp-route-id="@Model.Course.CourseCode" method="post" class="row g-2 col-md-6">
        <div class="col">
            <select name="studentNumber" class="form-select">
                @foreach (var s in others)
                {
                    <option value="@s.StudentNumber">@s.StudentNumber - @s.FullName</option>
                }
            </select>
        </div>
        <div class="col-auto"><button class="btn btn-success">Add student</button></div>
    </form>
}

<form asp-controller="Home" asp-action="ProcessQueue" method="post" class="mt-3">
    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
    <button class="btn btn-outline-secondary btn-sm">Process queue now</button>
    <a asp-action="Index" class="btn btn-link">Back to courses</a>
</form>
