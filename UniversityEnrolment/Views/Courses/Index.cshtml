@model List<UniversityEnrolment.Models.Course>
@{
    ViewData["Title"] = "Courses";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Available Courses</h1>
    <a asp-action="Create" class="btn btn-primary">Add course</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No courses yet. Click <strong>Add course</strong> to create one.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Code</th><th>Name</th><th>Instructor</th><th>Credits</th><th>Enrolled</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CourseCode</td>
                <td>@c.Name</td>
                <td>@c.Instructor</td>
                <td>@c.Credits</td>
                <td>@c.GetRoster().Count / @c.Capacity</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Roster" asp-route-id="@c.CourseCode" class="btn btn-sm btn-outline-success">Roster</a>
                    <a asp-action="Details" asp-route-id="@c.CourseCode" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@c.CourseCode" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@c.CourseCode" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
